# ---------------------------------------------------------------
# Mushafs environment configuration
# Copy this file to `.env` and fill in real values.
# NEVER commit the real .env file.
# ---------------------------------------------------------------

# --- Server ---
NODE_ENV=development
API_PORT=4100
# Origin the browser app is served from (used for CORS / CSRF origin check)
CLIENT_ORIGIN=http://localhost:5173

# --- PostgreSQL ---
# Local PostgreSQL connection. The docker-compose service exposes port 5433.
DB_HOST=localhost
DB_PORT=5433
DB_NAME=mushafs
DB_USER=mushafs
DB_PASSWORD=change-me
DB_SSL=false
# Max pool size
DB_POOL_MAX=10

# --- Security ---
# Long random string used to sign session tokens (min 32 chars).
# Generate one with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-chars
JWT_EXPIRES_IN=12h
# 32-byte key, hex encoded (64 hex chars), used to encrypt personal data (ID, IBAN, ID documents).
# Generate one with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
DATA_ENCRYPTION_KEY=replace-with-64-hex-characters-generated-with-the-command-above-00

# --- File storage ---
# Directory for audio files and private documents. Can point to a mounted Synology share.
STORAGE_DIR=./storage
# Max upload size in megabytes (a 30 min WAV is ~300 MB)
MAX_UPLOAD_MB=1024
# Bitrate of the automatically created light listening copy (MP3)
LIGHT_COPY_BITRATE=96k

# --- Scheduler ---
# How often (seconds) stage timers are evaluated for orange / red escalation
TIMER_INTERVAL_SECONDS=60

# --- Development tools ---
# Shows a role switcher at the top of the app to sign in as any user without a password.
# Only works when NODE_ENV=development and only from this machine; never enable it on a server.
DEV_ROLE_SWITCHER=true

# --- Logging ---
LOG_LEVEL=info
